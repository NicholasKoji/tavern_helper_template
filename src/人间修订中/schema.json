{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "当前场景": {
      "default": {},
      "type": "object",
      "properties": {
        "地点": {
          "default": "待生成",
          "type": "string"
        },
        "时间": {
          "default": "待生成",
          "type": "string"
        },
        "摘要": {
          "default": "等待玩家完成世界配置",
          "type": "string"
        }
      }
    },
    "世界配置": {
      "default": {},
      "type": "object",
      "properties": {
        "世界模板": {
          "default": "现代都市",
          "type": "string"
        },
        "世界观描述": {
          "default": "普通现代都市，玩家刚捡到现实编辑器",
          "type": "string"
        },
        "时代背景": {
          "default": "现代都市",
          "type": "string"
        },
        "文明与势力": {
          "default": "普通现代社会，势力简单",
          "type": "string"
        },
        "地理与气候": {
          "default": "普通城市环境，四季分明",
          "type": "string"
        },
        "历史与事件": {
          "default": "无特殊历史事件",
          "type": "string"
        },
        "核心冲突": {
          "default": "暂无明确主线，先由日常荒诞展开",
          "type": "string"
        },
        "玩法模式": {
          "default": {},
          "type": "object",
          "properties": {
            "认知": {
              "default": "是",
              "type": "string",
              "enum": [
                "是",
                "否"
              ]
            },
            "使用": {
              "default": "是",
              "type": "string",
              "enum": [
                "是",
                "否"
              ]
            },
            "受控": {
              "default": "是",
              "type": "string",
              "enum": [
                "是",
                "否"
              ]
            },
            "编辑器篡改": {
              "default": "D-完全禁止",
              "type": "string",
              "enum": [
                "A-完全随机",
                "B-倾向色色",
                "C-不涉及物理",
                "D-完全禁止",
                "E-玩家插件伪装"
              ]
            }
          }
        },
        "基调": {
          "default": {},
          "type": "object",
          "properties": {
            "色情浓度": {
              "default": 40,
              "type": "number"
            },
            "搞笑程度": {
              "default": 70,
              "type": "number"
            },
            "轻松程度": {
              "default": 70,
              "type": "number"
            }
          }
        },
        "允许黑深残": {
          "default": false,
          "type": "boolean"
        },
        "主角补充设定": {
          "default": "暂无补充设定",
          "type": "string"
        },
        "剧情方向": {
          "default": {},
          "type": "object",
          "properties": {
            "开局场景": {
              "default": "家中",
              "type": "string"
            },
            "主线目标": {
              "default": "先弄清楚现实编辑器的来历与能力",
              "type": "string"
            },
            "节奏": {
              "default": "轻松",
              "type": "string",
              "enum": [
                "日常",
                "冒险",
                "悬疑",
                "轻松"
              ]
            },
            "暧昧开局": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        "常识规则": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "规则名"
          },
          "additionalProperties": {
            "type": "string",
            "description": "规则内容"
          }
        },
        "行为习惯": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "习惯名"
          },
          "additionalProperties": {
            "type": "string",
            "description": "习惯内容"
          }
        },
        "物理规则": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "规则名"
          },
          "additionalProperties": {
            "type": "string",
            "description": "规则内容"
          }
        },
        "超自然规则": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "规则名"
          },
          "additionalProperties": {
            "type": "string",
            "description": "规则内容"
          }
        },
        "创建时间": {
          "default": "",
          "type": "string"
        }
      }
    },
    "现实编辑器": {
      "default": {},
      "type": "object",
      "properties": {
        "状态": {
          "default": "待机",
          "type": "string",
          "enum": [
            "正常",
            "维护中",
            "待机"
          ]
        },
        "版本": {
          "default": "v0.1.0-alpha",
          "type": "string"
        },
        "权限": {
          "default": {},
          "type": "object",
          "properties": {
            "修改世界规则": {
              "default": true,
              "type": "boolean"
            },
            "修改自身权限": {
              "default": false,
              "type": "boolean"
            },
            "卸载本设备": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        "生效规则": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "规则类别"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "description": "规则名"
            },
            "additionalProperties": {
              "type": "string",
              "description": "规则内容"
            }
          }
        }
      }
    },
    "主角": {
      "default": {},
      "type": "object",
      "properties": {
        "姓名": {
          "default": "",
          "type": "string"
        },
        "身份": {
          "default": "普通居民",
          "type": "string"
        },
        "补充设定": {
          "default": "",
          "type": "string"
        },
        "性格": {
          "default": "",
          "type": "string"
        },
        "目标": {
          "default": "",
          "type": "string"
        },
        "与编辑器关系": {
          "default": "刚捡到",
          "type": "string"
        }
      }
    },
    "NPC序列": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "NPC名称"
      },
      "additionalProperties": {
        "default": {},
        "type": "object",
        "properties": {
          "基础信息": {
            "default": {},
            "type": "object",
            "properties": {
              "姓名": {
                "default": "",
                "type": "string"
              },
              "性别": {
                "default": "女",
                "type": "string"
              },
              "年龄": {
                "default": "",
                "type": "string"
              },
              "身份": {
                "default": "",
                "type": "string"
              },
              "与主角关系": {
                "default": "",
                "type": "string"
              },
              "外貌特征": {
                "default": "",
                "type": "string"
              },
              "性格": {
                "default": "",
                "type": "string"
              }
            }
          },
          "当前想法": {
            "default": "",
            "type": "string"
          }
        }
      }
    }
  }
}